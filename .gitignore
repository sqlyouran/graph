# Java build outputs
target/
build/
out/
*.class
*.jar
*.war
*.ear

# Frontend dependencies and build outputs
web/node_modules/
web/dist/

# Maven and Gradle local state
.mvn/timing.properties
.gradle/

# IDE settings
.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# Local configuration and secrets
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-local.yaml

# Logs, reports, and temporary files
# logs/ 同时盖住 PromptDumper 快照目录 logs/prompts/（含用户请求，不进仓库）
*.log
logs/
*.tmp
*.temp
.DS_Store

# 临时验证产物（截图 / 导出稿等），本地一次性使用，不进仓库
tmp-verify/

# 渲染产物（PPT 导出图 / PDF / SSE 冒烟记录），本地一次性使用，不进仓库
_render/

# Local planning session traces (runtime output, 本地 trace 信息，不进仓库)
backend/data/planning-sessions/

# 用户画像（跨会话偏好）是个人数据，不是系统缓存，绝不进仓库
backend/data/profiles/

# Local scripts
script/
